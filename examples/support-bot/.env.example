# Pick one provider; leave the rest unset.
# No keys set -> vex falls back to a local ollama model.

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Overrides (optional)
# VEX_PROVIDER=auto            # auto|openai|anthropic|ollama
# VEX_OPENAI_MODEL=gpt-4o-mini
# VEX_ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# VEX_OLLAMA_MODEL=llama3.2
# VEX_OLLAMA_BASE_URL=http://localhost:11434/v1
