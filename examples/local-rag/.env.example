# local-rag defaults to the local ollama provider; no API key needed.
# Override any of these to point at a different local model or a hosted
# provider.

# VEX_PROVIDER=ollama          # ollama|openai|anthropic|auto
# VEX_OLLAMA_MODEL=llama3.2
# VEX_OLLAMA_BASE_URL=http://localhost:11434/v1

# OPENAI_API_KEY=sk-...
# VEX_OPENAI_MODEL=gpt-4o-mini
